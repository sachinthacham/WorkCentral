# ── Required ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/saas-platform
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# ── Deployment ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (frontend URLs)
CORS_ORIGINS=http://localhost:3001
# Optional regex for dynamic origins, e.g. Vercel preview deployments
# CORS_ORIGIN_REGEX=^https://.*-yourname\.vercel\.app$
# Public frontend URL used inside emails
APP_URL=http://localhost:3001
# Persistent uploads location (Azure App Service: /home/data/uploads)
# UPLOADS_DIR=/home/data/uploads

# ── SMTP (optional; defaults to a no-op Ethereal stub) ──────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Workspace App" <no-reply@workspace.com>
